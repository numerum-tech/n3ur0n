# ---- Rust ----
/target/
**/target/
**/*.rs.bk
Cargo.lock.bak
*.profraw
coverage/
tarpaulin-report.*

# ---- Frontend ----
# The web UI (crates/server/ui/) is hand-written static assets with no build
# step, so it has no generated output to ignore. These stay for tooling that
# may drop artefacts locally.
node_modules/
dist/
out/

# ---- Tauri build artefacts (CI emits installers; never check them in) ----
crates/desktop/target/
crates/desktop/gen/schemas/
crates/desktop/gen/apple/
crates/desktop/gen/android/

# ---- Local runtime + identity (must NEVER ship) ----
*.sqlite
*.sqlite-journal
keys.json
.config/
config/local/

# ---- Secrets / signing material ----
.env
.env.*
!.env.example
*.pem
*.crt
*.key
*.p12
*.pfx
*.keystore
*.mobileprovision
.tauri-signing-key
*.tauri-key
*.tauri-pub
secrets/

# ---- Editor / OS junk ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
*.swp
*.swo
*~
*.orig
*.rej

# ---- Logs / temp ----
*.log
logs/
tmp/
.tmp/

# ---- Agent tooling ----
# .wolf/ is committed by design (OpenWolf 2.5): team-shared, reviewed project
# state travels with git. Its own .wolf/.gitignore excludes the machine-local
# half — hooks/, cache/, backups/, the token ledger, daemon files and the
# dashboard token.
# .claude/ stays local by default: settings.json hardcodes absolute paths from
# one machine. Only the OpenWolf contract files CLAUDE.md points at are tracked.
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/handoff.md
!.claude/rules/
.claude/rules/*
!.claude/rules/openwolf.md
!.claude/skills/
.claude/skills/*
!.claude/skills/openwolf/
# Same rule for the other agents' hook wiring: it hardcodes one machine's
# absolute paths, so it is regenerated locally by `openwolf update`.
.codex/hooks.json

# ---- Internal session notes (kept local; public tracker is ROADMAP.md) ----
SESSION_STATE.md
WORK_PLAN.md
WORK_HISTORY/

# local editing backups
www/*.bak
